{
    "dependencies": {
        "@ai-sdk/google": "^4.0.44",
        "@inquirer/prompts": "^8.5.2",
        "@modelcontextprotocol/server": "^2.0.0",
        "ai": "^7.0.65",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "tsx": "^4.23.12",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@modelcontextprotocol/inspector": "^2.1.0",
        "@types/express": "^5.0.6",
        "@types/json-schema": "^7.0.15",
        "@types/node": "^26.2.0",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "server:build": "tsc",
        "server:build:watch": "tsc --watch",
        "server:dev": "tsx src/server.ts",
        "server:inspect": "set DANGEROUSLY_OMIT_AUTH=true && npx @modelcontextprotocol/inspector npm run server:dev",
        "client:dev": "tsx src/client.ts",
        "api:dev": "tsx api/index.ts",
        "start": "tsx api/index.ts"
    },
    "allowScripts": {
        "@modelcontextprotocol/inspector@2.1.0": true,
        "esbuild@0.28.2": true
    },
    "type": "module",
    "name": "mcp",
    "version": "1.0.0"
